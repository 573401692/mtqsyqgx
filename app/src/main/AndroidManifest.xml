<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mtqsyqgx.app"
    android:versionCode="168"
    android:versionName="1.6.8">

    <!-- 网络权限（地图加载、搜索、逆地理编码需要） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 可选：用于获取设备当前位置（若需要地图定位到当前位置） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 存储权限（配置文件和日志写入） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Android 11+ 需要此权限才能访问外部存储任意目录 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
    android:name=".App"
    android:icon="@drawable/ic_launcher"
    android:label="@string/app_name"
    android:description="@string/module_description"
    android:theme="@android:style/Theme.Holo.Light"
    android:allowBackup="false"
    android:supportsRtl="true"
    android:requestLegacyExternalStorage="true"
    android:networkSecurityConfig="@xml/network_security_config">

        <!-- 主界面 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 地图选点 Activity -->
        <activity
            android:name=".MapPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!-- 设置页面 Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 隐藏设置页面 Activity -->
        <activity
            android:name=".HiddenSettingsActivity"
            android:exported="false" />

        <!-- libxposed service 绑定 Provider（官方 XposedServiceHelper 依赖） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true" />

        <!-- 安装 APK 用文件 Provider（ACTION_VIEW 兜底路径） -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkfile"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- PackageInstaller 安装结果接收器 -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />

        <!-- 安装 APK 文件 Provider（自实现，免 FileProvider 依赖） -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkfile"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 悬浮窗自动抢单服务 -->
        <service
            android:name=".FloatingWindowService"
            android:exported="false" />

        <!-- 跨进程订单通道：采集器(美团进程)通过 ContentResolver 推送订单，无 su 依赖 -->
        <provider
            android:name=".OrdersProvider"
            android:authorities="com.mtqsyqgx.app.orders"
            android:exported="true" />

        
        <!-- ========== Xposed 模块声明（LSPosed 要求） ========== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="配送辅助模块" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="hook_config" />
        <!-- 推荐作用域：引用资源数组 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>
</manifest>