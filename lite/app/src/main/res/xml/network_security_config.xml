<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 禁用明文流量，强制使用HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- 信任系统证书 -->
            <certificates src="system" />
            <!-- 信任用户安装的证书（调试用） -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- 可选：为特定域名配置证书固定 -->
